distclean-generic:
	-test -z "$(CONFIG_CLEAN_FILES)" || rm -f $(CONFIG_CLEAN_FILES)
	-test . = "$(srcdir)" || test -z "$(CONFIG_CLEAN_VPATH_FILES)" || rm -f $(CONFIG_CLEAN_VPATH_FILES)
	-test -z "$(top_builddir)/OneWifi/source/utils/$(DEPDIR)/$(am__dirstamp)" || rm -f $(top_builddir)/OneWifi/source/utils/$(DEPDIR)/$(am__dirstamp)
	-test -z "$(top_builddir)/OneWifi/source/utils/$(am__dirstamp)" || rm -f $(top_builddir)/OneWifi/source/utils/$(am__dirstamp)
	-test -z "$(top_builddir)/src/cmd/$(DEPDIR)/$(am__dirstamp)" || rm -f $(top_builddir)/src/cmd/$(DEPDIR)/$(am__dirstamp)
	-test -z "$(top_builddir)/src/cmd/$(am__dirstamp)" || rm -f $(top_builddir)/src/cmd/$(am__dirstamp)
	-test -z "$(top_builddir)/src/dm/$(DEPDIR)/$(am__dirstamp)" || rm -f $(top_builddir)/src/dm/$(DEPDIR)/$(am__dirstamp)
	-test -z "$(top_builddir)/src/dm/$(am__dirstamp)" || rm -f $(top_builddir)/src/dm/$(am__dirstamp)
	-test -z "$(top_builddir)/src/em/$(DEPDIR)/$(am__dirstamp)" || rm -f $(top_builddir)/src/em/$(DEPDIR)/$(am__dirstamp)
	-test -z "$(top_builddir)/src/em/$(am__dirstamp)" || rm -f $(top_builddir)/src/em/$(am__dirstamp)
	-test -z "$(top_builddir)/src/em/crypto/$(DEPDIR)/$(am__dirstamp)" || rm -f $(top_builddir)/src/em/crypto/$(DEPDIR)/$(am__dirstamp)
	-test -z "$(top_builddir)/src/em/crypto/$(am__dirstamp)" || rm -f $(top_builddir)/src/em/crypto/$(am__dirstamp)
	-test -z "$(top_builddir)/src/em/prov/easyconnect/$(DEPDIR)/$(am__dirstamp)" || rm -f $(top_builddir)/src/em/prov/easyconnect/$(DEPDIR)/$(am__dirstamp)
	-test -z "$(top_builddir)/src/em/prov/easyconnect/$(am__dirstamp)" || rm -f $(top_builddir)/src/em/prov/easyconnect/$(am__dirstamp)
	-test -z "$(top_builddir)/src/rdkb-cli/$(DEPDIR)/$(am__dirstamp)" || rm -f $(top_builddir)/src/rdkb-cli/$(DEPDIR)/$(am__dirstamp)
	-test -z "$(top_builddir)/src/rdkb-cli/$(am__dirstamp)" || rm -f $(top_builddir)/src/rdkb-cli/$(am__dirstamp)
	-test -z "$(top_builddir)/src/util_crypto/$(DEPDIR)/$(am__dirstamp)" || rm -f $(top_builddir)/src/util_crypto/$(DEPDIR)/$(am__dirstamp)
	-test -z "$(top_builddir)/src/util_crypto/$(am__dirstamp)" || rm -f $(top_builddir)/src/util_crypto/$(am__dirstamp)
	-test -z "$(top_builddir)/src/utils/$(DEPDIR)/$(am__dirstamp)" || rm -f $(top_builddir)/src/utils/$(DEPDIR)/$(am__dirstamp)
	-test -z "$(top_builddir)/src/utils/$(am__dirstamp)" || rm -f $(top_builddir)/src/utils/$(am__dirstamp)

